m\u001b[40m \u001b[32m ability to\u001b[37m   \u001b[33m│\u001b(B\u001b[m\u001b[37m\u001b[40mclimb \u001b[33m│\u001b(B\u001b[m\u001b[37m\u001b[40m                                                                            \u001b[33m\u001b[9;1H│\u001b(B\u001b[m\u001b[37m\u001b[40m \u001b[32ma\u001b[37m  \u001b[33m│\u001b(B\u001b[m\u001b[37m\u001b[40mtree,\u001b[33m│\u001b(B\u001b[m\u001b[37m\u001b[40m it \u001b[33m│\u001b(B\u001b[m\u001b[37m\u001b[40m will \u001b[33m│\u001b(B\u001b[m\u001b[37m\u001b[40m                                                                            \u001b[33m\u001b[10;1H│\u001b(B\u001b[m\u001b[32m\u001b[40mli\u001b[37mve\u001b[33m│\u001b(B\u001b[m\u001b[37m\u001b[40m \u001b[33m───\u001b(B\u001b[m\u001b[37m\u001b[40m \u001b[33m│\u001b(B\u001b[m\u001b[37m\u001b[40m its\u001b[33m├──\u001b(B\u001b[m\u001b[37m\u001b[40m \u001b[33m───┤\u001b(B\u001b[m\u001b[37m\u001b[40m                                                                            \u001b[33m\u001b[11;1H│\u001b(B\u001b[m\u001b[37m\u001b[40m   \u001b[36m~\u001b[33m│\u001b(B\u001b[m\u001b[37m\u001b[40mwhole\u001b[33m│\u001b(B\u001b[m\u001b[37m\u001b[40mlife\u001b[33m│\u001b(B\u001b[m\u001b[37m\u001b[40m     \u001b[36m~\u001b[33m│\u001b(B\u001b[m\u001b[37m\u001b[40m                                                                            \u001b[33m\u001b[12;1H└─┐\u001b(B\u001b[m\u001b[37m\u001b[40mwhe\u001b[31mG\u001b[33m──\u001b(B\u001b[m\u001b[37m\u001b[40m  \u001b[33m└──\u001b(B\u001b[m\u001b[37m\u001b[40m you\u001b[33m┌──\u001b(B\u001b[m\u001b[37m\u001b[40m  \u001b[33m│\u001b(B\u001b[m\u001b[37m\u001b[40m                                                                            \u001b[13;1H  \u001b[33m│\u001b(B\u001b[m\u001b[37m\u001b[40m believing that\u001b[33m│\u001b(B\u001b[m\u001b[37m\u001b[40m it\u001b[33m┌┘\u001b(B\u001b[m\u001b[37m\u001b[40m                                                                            \u001b[14;1H  \u001b[33m└───────┐\u001b(B\u001b[m\u001b[37m\u001b[40m \u001b[33m─────\u001b(B\u001b[m\u001b[37m\u001b[40m is\u001b[33m──┤\u001b(B\u001b[m\u001b[37m\u001b[40m                                                                             \u001b[15;1H          \u001b[33m│\u001b(B\u001b[m\u001b[37m\u001b[40m  stupid   \u001b[33m│\u001b(B\u001b[m\u001b[37m\u001b[40m                                                                             \u001b[16;1H          \u001b[33m└───────────┘\u001b(B\u001b[m\u001b[37m\u001b[40m                                                                             \u001b[17;1H                                                                                                    \u001b[18;1H Points: 12/120                                                                                     \u001b[19;1H Lives: 3                                                                                           \u001b[20;1H                                                                                                    \u001b[21;1H                                                                                                    \u001b[22;1H                                                                                                    \u001b[23;1H                                                                                                    \u001b[24;1H                                                   "]
